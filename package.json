{
  "name": "birthday-wish",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"WORKER,CLIENT\" -c \"cyan.bold,magenta.bold\" \"wrangler dev --port 8787\" \"vite\"",
    "dev:worker": "wrangler dev --port 8787",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute DB --local --file=./migrations/0001_initial.sql && wrangler d1 execute DB --local --file=./migrations/0002_temporary_media.sql",
    "db:migrate:remote": "wrangler d1 execute DB --remote --file=./migrations/0001_initial.sql && wrangler d1 execute DB --remote --file=./migrations/0002_temporary_media.sql",
    "db:migrate:0002:remote": "wrangler d1 execute DB --remote --file=./migrations/0002_temporary_media.sql",
    "test": "tsx test-suite.ts"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^13.1.0",
    "hono": "^4.13.5",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.31.0",
    "mongodb": "^7.5.0",
    "multer": "^2.2.0",
    "nanoid": "^6.0.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.12",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260827.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wrangler": "^4.126.0"
  }
}
