# ===================================================
# Birthday Magic - Cloudflare Workers Configuration
# ===================================================
#
# Free 100% Zero-Cost Deployment (No payment method required)
#
# Bindings configured in wrangler.jsonc:
# - D1 Database: DB (birthday-wish-db)
# - Assets: ASSETS (./dist)
# - Cron Trigger: 0 * * * * (Hourly cleanup for 72-hour temporary media)
#
# Create D1 database: npx wrangler d1 create birthday-wish-db
#
# ===================================================
# Cloudinary Temporary Media Storage (72-Hour Auto Deletion)
# ===================================================
# Add these secrets to your Cloudflare Worker via Wrangler CLI:
#   npx wrangler secret put CLOUDINARY_CLOUD_NAME
#   npx wrangler secret put CLOUDINARY_API_KEY
#   npx wrangler secret put CLOUDINARY_API_SECRET
#
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
# Optional unsigned upload preset fallback:
# CLOUDINARY_UPLOAD_PRESET=birthday_preset

# Optional custom API base (defaults to same-origin /api):
# VITE_API_BASE_URL=/api
