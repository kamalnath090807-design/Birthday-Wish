# ===================================================
# Birthday Magic - Environment Variables Configuration
# ===================================================

# 1. OPTIONAL: MongoDB Atlas (For permanent cloud storage across Vercel serverless cold starts)
# Get a free connection string at https://cloud.mongodb.com
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=birthday_wish

# 2. OPTIONAL: Cloudinary (For media storage)
# Get free API credentials at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# 3. OPTIONAL: Custom API Base URL (Only if hosting API on separate domain like Render)
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
